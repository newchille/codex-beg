# Copy the values into your shell environment; never commit a real key.
# The runtime key should preferably be stored in a user-only file instead.
export CONTROL_PLANE_TUNNEL_ID='tunnel_0123456789abcdef0123456789abcdef'
export CONTROL_PLANE_API_KEY_FILE="$HOME/.config/codex-beg/secrets/control-plane-api-key"
export TUNNEL_CLIENT_ALIAS='codex-beg'
export MCP_SERVER_URL='http://127.0.0.1:43123/mcp'
export CODEX_BEG_HEALTH_URL='http://127.0.0.1:43123/healthz'
