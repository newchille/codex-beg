{
  "name": "@codex-beg/desktop",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Codex BEG local-first safety core desktop application",
  "author": "Codex BEG contributors",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm --filter @codex-beg/core build && pnpm --filter @codex-beg/agent-host build && electron-vite dev",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "pnpm --filter @codex-beg/agent-host exec esbuild ../desktop/electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=../desktop/dist/preload.cjs",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "pnpm typecheck",
    "package:icon": "sh ../../scripts/build-macos-icon.sh && sh ../../scripts/build-tray-icon.sh",
    "package": "pnpm package:icon && pnpm --filter @codex-beg/core build && pnpm --filter @codex-beg/agent-host build && pnpm build && electron-builder --dir --publish never",
    "package:dmg": "pnpm package:icon && pnpm --filter @codex-beg/core build && pnpm --filter @codex-beg/agent-host build && pnpm build && electron-builder --mac dmg --arm64 --publish never"
  },
  "dependencies": {
    "@codex-beg/core": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "electron": "^36.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.1.1"
  },
  "build": {
    "appId": "com.codexbeg.desktop",
    "productName": "Codex BEG",
    "directories": { "output": "release" },
    "artifactName": "Codex-BEG-${version}-mac-${arch}.${ext}",
    "files": ["dist/**/*", "electron/trayIconTemplate.png", "electron/trayIconTemplate@2x.png", "package.json", "!node_modules/**/*"],
    "extraResources": [{ "from": "../agent-host/dist/main.js", "to": "agent-host/main.js" }],
    "win": { "target": [{ "target": "portable", "arch": ["x64"] }] },
    "mac": { "target": ["dir"], "identity": "-", "hardenedRuntime": false, "icon": "renderer/src/app-icon.icns" }
  }
}
